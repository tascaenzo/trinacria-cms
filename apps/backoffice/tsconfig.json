{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@trinacria-cms/admin-kernel": ["../../packages/admin-kernel/src/index.ts"],
      "@trinacria-cms/admin-ui": ["../../packages/admin-ui/src/index.ts"],
      "@trinacria-cms/sdk": ["../../packages/sdk/src/index.ts"]
    },
    "jsx": "react-jsx",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "allowSyntheticDefaultImports": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "tailwind.config.ts"]
}
