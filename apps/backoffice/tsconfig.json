{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "paths": {
      "@trinacria-cms/admin-kernel": ["../../packages/admin-kernel/src/index.ts"],
      "@trinacria-cms/core-pack/admin-manifest": [
        "../../packages/core-pack/src/plugin/core-pack-admin.manifest.ts"
      ],
      "@trinacria-cms/trinacria-ui": ["../../packages/trinacria-ui/src/index.ts"],
      "@trinacria-cms/sdk": ["../../packages/sdk/src/index.ts"]
    },
    "jsx": "react-jsx",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "allowSyntheticDefaultImports": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "tailwind.config.ts"]
}
