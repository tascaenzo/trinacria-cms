{
  "name": "@trinacria-cms/public-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --ssr src/server.tsx --outDir dist/server",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "node --import tsx --test test/**/*.test.ts",
    "start": "node dist/server/server.js"
  },
  "dependencies": {
    "@trinacria-cms/sdk": "0.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "vite": "^8.3.2"
  }
}
