PORT=3000
# Comma-separated origins allowed to call the playground API from a browser.
# Example: HTTP_CORS_ORIGINS=http://localhost:4174,http://127.0.0.1:4174
# HTTP_CORS_ORIGINS=
# Production must set explicit origins. Wildcard CORS is rejected in production.
# HTTP_CORS_ORIGINS=https://admin.example.com
# CMS_CSRF_TRUSTED_ORIGINS=https://admin.example.com
# CMS_PUBLIC_ORIGIN=https://api.example.com
# BACKOFFICE_PUBLIC_ORIGIN=https://admin.example.com
# CMS_CSRF_PROTECTION=true
# HTTP_TRUST_PROXY=true
# HTTP_REQUEST_TIMEOUT_MS=30000
# HTTP_RATE_LIMIT_WINDOW_MS=60000
# HTTP_RATE_LIMIT_MAX=300
# CMS_OPENAPI_ENABLED=false
# CMS_SWAGGER_ENABLED=false
# OBSERVABILITY_ENABLED=true
# METRICS_ENABLED=true
# OPS_CHECKLIST_ENABLED=true
# LOG_FORMAT=json
# REQUEST_LOG_USER_AGENT=false
# OBSERVABILITY_TOKEN=change-me-with-a-runtime-secret

MONGO_ROOT_USERNAME=trinacria
MONGO_ROOT_PASSWORD=trinacria
MONGO_DATABASE=trinacria_cms
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_URI=mongodb://trinacria:trinacria@127.0.0.1:27017/trinacria_cms?authSource=admin

MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin

# JWT auth (core-pack)
# Generate a strong random key when creating a new app instance.
# Example: openssl rand -base64 48
# In production prefer runtime secret injection or CMS_JWT_SECRET_FILE (Docker/Kubernetes secret)
# instead of a local .env file.
CMS_JWT_SECRET=change-me-with-a-long-random-secret
# CMS_JWT_SECRET_FILE=/run/secrets/cms_jwt_secret
CMS_STRICT_JWT_SECRET_REQUIRED=false
CMS_JWT_ACCESS_TTL_SECONDS=86400
CMS_JWT_REFRESH_TTL_SECONDS=2592000
CMS_JWT_ACCESS_COOKIE_NAME=cms_access_token
CMS_JWT_REFRESH_COOKIE_NAME=cms_refresh_token
CMS_JWT_COOKIE_PATH=/
CMS_JWT_COOKIE_SAME_SITE=lax
CMS_JWT_COOKIE_SECURE=true
# CMS_JWT_COOKIE_DOMAIN=example.com
