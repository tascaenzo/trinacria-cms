{
  "name": "trinacria-cms",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "examples/*",
    "packages/kernel",
    "packages/core-pack",
    "packages/email-pack",
    "packages/editorial-pack",
    "packages/media-pack",
    "packages/sdk",
    "packages/admin-kernel",
    "packages/trinacria-ui"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "npm run build && turbo run dev --ui=tui",
    "dev:playground": "npm run build && turbo run dev --ui=tui --filter=@trinacria-cms/playground...",
    "dev:backoffice": "npm run build && turbo run dev --ui=tui --filter=@trinacria-cms/backoffice...",
    "dev:playground:watch": "npm run dev -w @trinacria-cms/playground",
    "dev:backoffice:watch": "npm run dev -w @trinacria-cms/backoffice",
    "storybook": "npm run storybook -w @trinacria-cms/trinacria-ui",
    "storybook:build": "turbo run storybook:build",
    "pree2e": "npm run build",
    "pree2e:ci": "npm run build",
    "e2e": "playwright test",
    "e2e:ci": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:typecheck": "turbo run build --filter=@trinacria-cms/playground... && tsc -p test/e2e/tsconfig.json --noEmit",
    "sdk:snapshot": "npm run snapshot:openapi -w @trinacria-cms/sdk",
    "sdk:generate": "turbo run generate --filter=@trinacria-cms/sdk",
    "sdk:build": "turbo run build --filter=@trinacria-cms/sdk",
    "sdk:test": "npm run test -w @trinacria-cms/sdk",
    "sdk:check": "npm run check:generated -w @trinacria-cms/sdk",
    "typecheck": "turbo run typecheck && npm run e2e:typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "lint": "turbo run lint && npm run ui:guardrails && npm run boundaries:check",
    "ui:guardrails": "node scripts/check-admin-ui-primitives.mjs && node scripts/check-admin-save-actions.mjs && node scripts/check-trinacria-ui-stories.mjs && node scripts/check-tailwind-compatibility.mjs",
    "turbo:affected": "node scripts/ci/run-affected-turbo.mjs",
    "lint:affected": "npm run turbo:affected -- lint",
    "typecheck:affected": "npm run turbo:affected -- typecheck && npm run e2e:typecheck",
    "build:affected": "npm run turbo:affected -- build",
    "test:affected": "npm run turbo:affected -- test",
    "test:integration:affected": "npm run turbo:affected -- test:integration",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "dependencies:check": "node scripts/check-workspace-dependencies.mjs",
    "check": "npm run format && npm run lint && npm run typecheck && npm run test && npm run dependencies:check && npm run boundaries:check",
    "check:write": "biome check --write .",
    "boundaries:check": "node scripts/check-plugin-boundaries.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.19.0",
    "tsx": "^4.23.15",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.16.0 <12"
  }
}
