{
  "name": "@trinacria-cms/kernel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:integration": "node --import tsx --test test/**/*.integration.test.ts",
    "lint": "echo \"No lint config yet\""
  },
  "dependencies": {
    "@trinacria/core": "0.1.1-alpha.0",
    "@trinacria/http": "0.1.1-alpha.0",
    "@trinacria/schema": "0.1.1-alpha.0"
  },
  "peerDependencies": {
    "mongoose": ">=9"
  }
}
