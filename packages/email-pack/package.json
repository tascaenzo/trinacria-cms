{
  "name": "@trinacria-cms/email-pack",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./admin-manifest": {
      "types": "./dist/plugin/email-pack-admin.manifest.d.ts",
      "import": "./dist/plugin/email-pack-admin.manifest.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "lint": "biome check ."
  },
  "dependencies": {
    "@trinacria-cms/core-pack": "0.1.0",
    "@trinacria-cms/kernel": "0.1.0",
    "nodemailer": "^10.0.13"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@trinacria-cms/sdk": "0.1.0",
    "@trinacria-cms/trinacria-ui": "0.1.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@trinacria-cms/sdk": "0.1.0",
    "@trinacria-cms/trinacria-ui": "0.1.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@trinacria-cms/sdk": {
      "optional": true
    },
    "@trinacria-cms/trinacria-ui": {
      "optional": true
    }
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
