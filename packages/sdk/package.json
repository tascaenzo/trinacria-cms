{
  "name": "@trinacria-cms/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "snapshot:openapi": "node ./scripts/snapshot-openapi.mjs",
    "generate": "node ./scripts/generate-sdk.mjs ./openapi/trinacria-cms.openapi.json ./src/generated",
    "check:generated": "node ./scripts/check-generated.mjs",
    "build": "npm run generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "lint": "echo \"No lint config yet\""
  }
}
