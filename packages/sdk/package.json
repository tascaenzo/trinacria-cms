{
  "name": "@trinacria-cms/sdk",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch",
    "snapshot:openapi": "node ./scripts/snapshot-openapi.mjs",
    "generate": "node ./scripts/generate-sdk.mjs ./openapi/trinacria-cms.openapi.json ./src/generated",
    "check:generated": "node ./scripts/check-generated.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "lint": "biome check ."
  },
  "bin": {
    "trinacria-sdk": "./scripts/generate-sdk.mjs"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "scripts/generate-sdk.mjs"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
