{
  "name": "@trinacria-cms/trinacria-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./theme.css"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src .storybook theme.css package.json",
    "test": "node --import tsx --test src/**/*.test.tsx",
    "storybook": "HOME=.storybook-home storybook dev -p 6006 -c .storybook",
    "storybook:build": "HOME=.storybook-home storybook build -c .storybook"
  },
  "dependencies": {
    "lucide-react": "^1.49.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "storybook": "10.6.1",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
