{
  "name": "@trinacria-cms/trinacria-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./theme.css"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "node --import tsx --test src/**/*.test.tsx",
    "storybook": "HOME=.storybook-home storybook dev -p 6006 -c .storybook",
    "storybook:build": "HOME=.storybook-home storybook build -c .storybook"
  },
  "dependencies": {
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.4.0",
    "@storybook/react-vite": "10.4.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "storybook": "10.4.0",
    "tailwindcss": "^4.2.2"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
