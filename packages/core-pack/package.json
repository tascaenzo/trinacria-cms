{
  "name": "@trinacria-cms/core-pack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin-api": {
      "types": "./dist/plugin-api/index.d.ts",
      "import": "./dist/plugin-api/index.js"
    },
    "./admin-manifest": {
      "types": "./dist/plugin/core-pack-admin.manifest.d.ts",
      "import": "./dist/plugin/core-pack-admin.manifest.js"
    },
    "./i18n": {
      "types": "./dist/admin-i18n/index.d.ts",
      "import": "./dist/admin-i18n/index.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch",
    "dev:runtime": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "lint": "biome check ."
  },
  "dependencies": {
    "@trinacria-cms/kernel": "0.1.0",
    "@trinacria/events": "^0.1.1",
    "@trinacria/schema": "0.1.1",
    "ioredis": "^5.10.1",
    "jose": "^6.2.0",
    "mongoose": ">=9"
  },
  "devDependencies": {
    "@types/ioredis": "^4.28.10",
    "@types/node": "^25.9.1"
  }
}
