{
  "name": "@trinacria-cms/editorial-pack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./admin-manifest": {
      "types": "./dist/plugin/editorial-pack-admin.manifest.d.ts",
      "import": "./dist/plugin/editorial-pack-admin.manifest.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "lint": "biome check .",
    "test:integration": "node --import tsx --test test/**/*.integration.test.ts"
  },
  "dependencies": {
    "@trinacria-cms/core-pack": "0.1.0",
    "@trinacria-cms/kernel": "0.1.0",
    "@trinacria-cms/media-pack": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "mongoose": "^9.10.3",
    "@trinacria-cms/sdk": "0.1.0",
    "@trinacria-cms/trinacria-ui": "0.1.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@trinacria-cms/sdk": "0.1.0",
    "@trinacria-cms/trinacria-ui": "0.1.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@trinacria-cms/sdk": {
      "optional": true
    },
    "@trinacria-cms/trinacria-ui": {
      "optional": true
    }
  }
}
